{
  "$schema": "https://mintlify.com/schema.json",
  "name": "MemSmith",
  "description": "Persistent memory for Claude Code: hooks capture activity, a generation provider writes observations, and a Postgres server recalls them",
  "theme": "mint",
  "favicon": "/memsmith-logomark.webp",
  "logo": {
    "light": "/memsmith-logo-for-light-mode.webp",
    "dark": "/memsmith-logo-for-dark-mode.webp",
    "href": "https://github.com/shshalom/memsmith"
  },
  "colors": {
    "primary": "#3B82F6",
    "light": "#EFF6FF",
    "dark": "#1E40AF"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/shshalom/memsmith"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Install",
      "href": "https://github.com/shshalom/memsmith#quick-start"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "icon": "rocket",
        "pages": [
          "introduction",
          "installation",
          "usage/getting-started"
        ]
      },
      {
        "group": "Using MemSmith",
        "icon": "book-open",
        "pages": [
          "usage/memory-tools",
          "usage/notes",
          "cli-reference",
          "usage/projects",
          "dashboard",
          "usage/actor-tags",
          "usage/read-only-mode",
          "usage/hook-switches",
          "usage/incognito",
          "usage/transcript-watcher",
          "usage/private-tags",
          "usage/secret-redaction",
          "modes"
        ]
      },
      {
        "group": "Configuration",
        "icon": "gear",
        "pages": [
          "configuration",
          "settings-reference",
          "providers",
          "usage/gemini-provider",
          "usage/openrouter-provider",
          "configuration/litellm-gateway",
          "generation",
          "runtimes",
          "telemetry"
        ]
      },
      {
        "group": "Team server",
        "icon": "cloud",
        "pages": [
          "hosted-server"
        ]
      },
      {
        "group": "Integrations",
        "icon": "plug",
        "pages": [
          "usage/claude-desktop",
          "cursor/index",
          "cursor/gemini-setup",
          "cursor/openrouter-setup",
          "antigravity-cli/setup",
          "platform-integration"
        ]
      },
      {
        "group": "Architecture",
        "icon": "diagram-project",
        "pages": [
          "architecture/overview",
          "architecture/hooks",
          "progressive-disclosure",
          "context-engineering",
          "smart-explore-benchmark"
        ]
      },
      {
        "group": "Troubleshooting",
        "icon": "wrench",
        "pages": [
          "troubleshooting"
        ]
      },
      {
        "group": "Contributing",
        "icon": "code",
        "pages": [
          "development"
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/shshalom/memsmith"
    },
    "links": [
      {
        "header": "Resources",
        "items": [
          {
            "label": "Documentation",
            "href": "https://github.com/shshalom/memsmith"
          },
          {
            "label": "Issues",
            "href": "https://github.com/shshalom/memsmith/issues"
          }
        ]
      },
      {
        "header": "Legal",
        "items": [
          {
            "label": "License (Apache-2.0)",
            "href": "https://github.com/shshalom/memsmith/blob/main/LICENSE"
          }
        ]
      }
    ]
  },
  "seo": {
    "indexing": "all",
    "metatags": {
      "og:type": "website",
      "og:site_name": "MemSmith Documentation",
      "og:description": "Persistent memory for Claude Code: hooks capture activity, a generation provider writes observations, and a Postgres server recalls them"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor"
    ]
  },
  "integrations": {
    "telemetry": {
      "enabled": false
    }
  }
}
